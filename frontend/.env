REACT_APP_BACKEND_URL=https://artisan-print-studio.preview.emergentagent.com
# NOTE: do NOT set WDS_SOCKET_PORT=443 here. It forced the webpack HMR client
# to dial ws://localhost:443/ws while the dev server runs on :3000, so react-refresh
# never connected and spammed ERR_CONNECTION_REFUSED. Unset = auto-detected port.
ENABLE_HEALTH_CHECK=false
GENERATE_SOURCEMAP=false
